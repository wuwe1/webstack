{
  "name": "webstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter web --filter api dev",
    "secrets": "node tooling/secret-scan/src/cli.js git --redact --no-banner --verbose --ignore-gitleaks-allow .",
    "typecheck": "tsc && pnpm -r typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "eslint . --max-warnings 0",
    "arch": "depcruise .",
    "knip": "knip",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm --filter web build",
    "e2e": "pnpm build && playwright test",
    "size": "size-limit",
    "check": "pnpm secrets && pnpm typecheck && pnpm fmt:check && pnpm lint && pnpm arch && pnpm knip && pnpm test && pnpm e2e && pnpm size",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@webstack/eslint-config": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.33.0"
}
