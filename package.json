{
  "name": "webstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter web --filter api dev",
    "typecheck": "tsc && pnpm -r typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "eslint . --max-warnings 0",
    "arch": "depcruise apps packages",
    "knip": "knip",
    "test": "pnpm -r test",
    "build": "pnpm --filter web build",
    "e2e": "playwright test",
    "size": "size-limit",
    "check": "pnpm typecheck && pnpm fmt:check && pnpm lint && pnpm arch && pnpm knip && pnpm test && pnpm build && pnpm size && pnpm e2e",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@playwright/test": "catalog:",
    "@size-limit/file": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@webstack/eslint-config": "workspace:*",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "size-limit": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
