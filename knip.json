{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.spec.ts"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "src/components/ui/*.tsx"]
    },
    "apps/api": {},
    "packages/shared": {},
    "packages/eslint-config": {
      "ignore": ["fixtures/**"],
      "ignoreDependencies": ["@types/react", "react", "typescript"]
    },
    "packages/commit-msg": {
      "entry": ["src/cli.js"]
    }
  }
}
