{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.spec.ts"]
    },
    "apps/web": {
      "entry": ["src/routes/**/*.tsx", "src/components/ui/*.tsx"]
    },
    "apps/api": {},
    "tooling/arch-rules": {
      "ignore": ["fixtures/**"]
    },
    "tooling/eslint-config": {
      "ignore": ["fixtures/**"],
      "ignoreDependencies": ["@types/react", "react", "typescript"]
    },
    "tooling/agent-hooks": {
      "entry": ["src/check-on-stop.js", "src/guard-bash-cli.js"]
    },
    "tooling/commit-msg": {
      "entry": ["src/cli.js"]
    }
  }
}
