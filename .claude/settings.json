{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/agent-hooks/src/guard-bash-cli.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/agent-hooks/src/check-on-stop.js\"",
            "timeout": 300,
            "statusMessage": "Running pnpm check"
          }
        ]
      }
    ]
  }
}
